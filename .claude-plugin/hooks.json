{
  "description": "Akasha hooks. They act only in repositories that use Akasha (akasha.toml). hook.sh finds Python 3.11 or higher.",
  "hooks": {
    "SessionStart": [{"matcher": "startup|resume|clear|compact", "hooks": [
      {"type": "command", "timeout": 30, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" SessionStart"}]}],
    "UserPromptSubmit": [{"hooks": [
      {"type": "command", "timeout": 20, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" UserPromptSubmit"}]}],
    "PreToolUse": [
      {"matcher": "Bash|PowerShell", "hooks": [
        {"type": "command", "timeout": 20, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" PreToolUse"}]},
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [
        {"type": "command", "timeout": 20, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" PreToolUse edit"}]}],
    "PostToolUse": [{"matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [
      {"type": "command", "timeout": 20, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" PostToolUse"}]}],
    "SubagentStop": [{"hooks": [
      {"type": "command", "timeout": 20, "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" SubagentStop"}]}]
  }
}
